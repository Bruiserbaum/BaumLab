# ── Authentication ─────────────────────────────────────────────────────────────
# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_HEX_SECRET

# Initial admin account — created automatically on first start if no users exist.
# Once created, changing these values here has no effect (edit the account in the UI).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# How long login tokens stay valid (hours). Default: 8
TOKEN_EXPIRE_HOURS=8

# ── Storage paths (optional) ───────────────────────────────────────────────────
# Where the database and config.yaml live on the host. Default: ./data and ./config
# next to docker-compose.yml. Set absolute paths when deploying as a Portainer Git
# stack — Portainer CE resolves relative paths inside its own compose folder.
# BAUMLAB_DATA_PATH=/opt/baumlab/data
# BAUMLAB_CONFIG_PATH=/opt/baumlab/config

# ── Ports (optional overrides) ─────────────────────────────────────────────────
# Change if these ports are already in use on your host
API_PORT=8100
UI_PORT=3100

# ── Authentik SSO (optional) ───────────────────────────────────────────────────
# Forward auth — header-based auto-login via Nginx Proxy Manager + Authentik.
# When NPM's forward auth is active, Authentik injects X-authentik-username into
# every request. Setting this to true lets BaumLab issue a local JWT automatically
# so the user never sees a login page.
# Requires the npm-forward-auth.conf snippet applied in NPM — see BaumDocker/authentik/README.
#
# AUTHENTIK_HEADER_AUTH=true
#
# IMPORTANT with header auth: BaumLab can't tell a header added by NPM from one a client
# typed in, if the client reaches ports 3100/8100 directly. Set a shared secret here and
# make NPM send it. In the proxy host's Advanced config, put this line inside the same
# location block as your forward-auth `proxy_set_header X-authentik-username ...` line
# (nginx ignores server-level proxy_set_header when the location sets its own):
#   proxy_set_header X-BaumLab-Proxy-Secret "<same value>";
# Generate with: openssl rand -hex 32. The credential vault stays locked until this is set.
# AUTHENTIK_PROXY_SECRET=REPLACE_WITH_HEX_SECRET

# ── Credential vault (optional) ────────────────────────────────────────────────
# Encryption key for stored passwords. Defaults to SECRET_KEY if unset; setting a
# separate key lets you rotate SECRET_KEY without losing the vault.
# BACK THIS UP — if it changes or is lost, stored passwords cannot be recovered.
# Generate with: openssl rand -hex 32
# VAULT_KEY=REPLACE_WITH_HEX_SECRET

# OIDC login via Authentik. When enabled, a "Login with Authentik" button
# appears on the login page alongside the existing username/password form.
#
# In Authentik: create an OAuth2/OpenID Provider + Application.
# Redirect URI to register in Authentik:
#   http://your-server:8100/api/auth/oidc/callback
#   (or https://baumlab.yourdomain.com/api/auth/oidc/callback if behind a reverse proxy)
#
# OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.yourdomain.com/application/o/<app-slug>/
# OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# OIDC_REDIRECT_URI=http://your-server:8100/api/auth/oidc/callback
#
# Only required when API and frontend are on different ports with no shared reverse proxy.
# Leave unset if both are behind the same proxy at a single domain.
# OIDC_FRONTEND_URL=http://your-server:3100
